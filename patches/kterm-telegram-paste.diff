+/* Feed one explicitly requested Telegram message into this terminal's child.
+ * The request file prevents ordinary syncs from altering terminal input. */
+static gboolean paste_file_cb(gpointer data) {
+    GtkWidget *terminal = GTK_WIDGET(data);
+    const gchar *path = g_object_get_data(G_OBJECT(terminal), "ktm-paste-file");
+    gchar *text = NULL;
+    gsize length = 0;
+    GError *error = NULL;
+
+    if (!path || !g_file_get_contents(path, &text, &length, &error)) {
+        if (error) {
+            g_printerr("ktm: cannot read pending message: %s\n", error->message);
+            g_error_free(error);
+        }
+        return FALSE;
+    }
+    if (length == 0 || !g_utf8_validate(text, length, NULL)) {
+        g_printerr("ktm: pending message is empty or not UTF-8\n");
+        g_free(text);
+        return FALSE;
+    }
+    for (gsize i = 0; i < length; i++) {
+        if (((guchar) text[i] < 0x20 && text[i] != '\t') || text[i] == 0x7f) {
+            g_printerr("ktm: pending message contains control characters\n");
+            g_free(text);
+            return FALSE;
+        }
+    }
+
+    vte_terminal_feed_child(VTE_TERMINAL(terminal), "\025", 1);
+    vte_terminal_feed_child(VTE_TERMINAL(terminal), text, length);
+    unlink(path);
+    g_free(text);
+    return FALSE;
+}
+
+static gboolean paste_request_cb(gpointer data) {
+    GtkWidget *terminal = GTK_WIDGET(data);
+    const gchar *request = g_object_get_data(G_OBJECT(terminal), "ktm-paste-request");
+
+    if (!request || access(request, F_OK) != 0) return TRUE;
+    unlink(request);
+    /* Let session.sh replace the menu program with the interactive shell first. */
+    g_timeout_add(800, paste_file_cb, terminal);
+    return FALSE;
+}
