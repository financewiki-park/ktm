--- a/kterm.c
+++ b/kterm.c
@@ -100,4 +100,37 @@ static void terminal_exit(void) {
     gtk_main_quit();
 }
 
+/**
+ * Feed one pending ktm message directly to VTE's child input.  This is not an
+ * X11 synthetic key event: VTE writes the bytes to its PTY.  Return/line-feed
+ * and all control bytes are rejected so a Telegram message can never execute
+ * itself.  Ctrl-U clears only the shell's editable line before insertion.
+ */
+static gboolean paste_file_cb(gpointer data) {
+    GtkWidget *terminal = GTK_WIDGET(data);
+    const gchar *path = g_object_get_data(G_OBJECT(terminal), "ktm-paste-file");
+    gchar *text = NULL;
+    gsize length = 0;
+    GError *error = NULL;
+    if (!path || !g_file_get_contents(path, &text, &length, &error)) {
+        if (error) { g_printerr("ktm paste: %s\n", error->message); g_error_free(error); }
+        return FALSE;
+    }
+    if (length == 0 || g_utf8_validate(text, length, NULL) == FALSE) {
+        g_printerr("ktm paste: message is empty or not UTF-8\n");
+        g_free(text); return FALSE;
+    }
+    for (gsize i = 0; i < length; i++) {
+        if ((guchar)text[i] < 0x20 || (guchar)text[i] == 0x7f) {
+            g_printerr("ktm paste: message contains a newline or control character\n");
+            g_free(text); return FALSE;
+        }
+    }
+    vte_terminal_feed_child(VTE_TERMINAL(terminal), "\025", 1);
+    vte_terminal_feed_child(VTE_TERMINAL(terminal), text, length);
+    unlink(path);
+    g_free(text);
+    return FALSE;
+}
+
